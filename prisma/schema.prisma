generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USUARIO
  DESARROLLADOR
  ADMINISTRADOR
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String?   @unique
  password        String?
  emailVerified   DateTime?
  image           String?   @default("https://placehold.co/600x600/orange/white?text=GFU")
  role            Role      @default(USUARIO)
  bio             String?
  birthDate       DateTime?
  country         String?
  active          Boolean?  @default(true)
  backgroundImage String? @default("https://placehold.co/600x600/orange/white?text=Games For Us")
  createdAt       DateTime  @default(now())
  lastLogin       DateTime?
  reportCount     Int       @default(0)

  accounts       Account[]
  contents       Content[]
  comments       Comment[]
  favoriteGames  Game[]    @relation("Favorites")
  developedGames Game[]    @relation("DevelopedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Game {
  id           Int       @id @default(autoincrement())
  name         String
  shortDesc    String?
  longDesc     String?
  releaseDate  DateTime?
  visible      Boolean?  @default(true)
  publishedAt  DateTime  @default(now())
  price        Float?
  averageScore Int?
  salesCount   Int?      @default(0)
  requirements Json?
  urls         Json?
  reportCount  Int       @default(0)

  contents   Content[]
  comments   Comment[]
  fans       User[]     @relation("Favorites")
  developers User[]     @relation("DevelopedBy")
  categories Category[]
  platforms  Platform[]
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  games       Game[]
}

model Platform {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  manufacturer String?
  games        Game[]
}

model Content {
  id          Int         @id @default(autoincrement())
  game        Game        @relation(fields: [gameId], references: [id])
  gameId      Int
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  type        ContentType
  title       String
  shortTitle  String?
  moreInfo    Json?
  urls        Json?
  text        String?
  publishedAt DateTime    @default(now())
  editedAt    DateTime?
  score       Int? @default(0)
  reportCount Int         @default(0)
  visible     Boolean?    @default(true)
  comments    Comment[]
}

enum ContentType {
  RESEÑA
  VIDEO
  IMAGEN
  NOTICIA
}

model Comment {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  game        Game?     @relation(fields: [gameId], references: [id])
  gameId      Int?
  content     Content?  @relation(fields: [contentId], references: [id])
  contentId   Int?
  text        String
  score       Int?
  publishedAt DateTime    @default(now())
  edited      Boolean   @default(false)
  editedAt    DateTime?
  visible     Boolean?  @default(true)
  reportCount Int       @default(0)

  //@@check((gameId IS NOT NULL AND contentId IS NULL) OR (gameId IS NULL AND contentId IS NOT NULL))

